# Environment Variables
# Copy this file to .env.local and update the values

# ── Required ──────────────────────────────────────
# Supabase project URL and anon key (public, safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Email (Resend) ────────────────────────────────
# Used by /api/waitlist and /api/contact
RESEND_API_KEY=re_xxxxxxxxxxxxx
WAITLIST_FROM_EMAIL=hello@yourdomain.com
WAITLIST_NOTIFY_TO=you@yourdomain.com

# ── Optional ──────────────────────────────────────
# Supabase service role key — only needed for /api/dossier
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel KV (rate limiting for waitlist)
# KV_REST_API_URL=https://xxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxx
# NEXT_PUBLIC_GITHUB_URL=https://github.com/relevant
